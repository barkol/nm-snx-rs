"""
nm-snx-rs-service — NetworkManager VPN plugin wrapping snx-rs.

Spawns and supervises a snx-rs subprocess for each VPN activation, reads the
assigned IPv4 address from the resulting interface, and reports it back to
NetworkManager via the standard org.freedesktop.NetworkManager.VPN.Plugin
D-Bus interface so the connection appears in the normal NM applet UI.

NM spawns this binary; we register the well-known bus name and wait for
Connect / NewSecrets / Disconnect calls. After a Disconnect we exit so NM
can spawn a fresh instance for the next activation.
"""

import base64
import logging
import os
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import time

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

SERVICE_NAME = "org.freedesktop.NetworkManager.snx-rs"
OBJECT_PATH  = "/org/freedesktop/NetworkManager/VPN/Plugin"
IFACE        = "org.freedesktop.NetworkManager.VPN.Plugin"

# NM_VPN_SERVICE_STATE
S_UNKNOWN, S_INIT, S_SHUTDOWN, S_STARTING, S_STARTED, S_STOPPING, S_STOPPED = range(7)
# NM_VPN_PLUGIN_FAILURE
F_LOGIN_FAILED, F_CONNECT_FAILED, F_BAD_IP_CONFIG = 0, 1, 2

SNX_RS = "/usr/bin/snx-rs"
DEFAULT_IFACE = "snx-xfrm"
WAIT_TIMEOUT = 90  # seconds to wait for snx-rs to bring the interface up

log = logging.getLogger("nm-snx-rs")


def ip_to_uint32(ip):
    """Return IPv4 as uint32 whose in-memory layout matches network byte order
    (i.e. what NM stores as in_addr_t and feeds into inet_ntop). Works on both
    LE and BE hosts because struct '=I' uses native endianness."""
    return struct.unpack("=I", socket.inet_aton(ip))[0]


def get_interface_ip(name):
    """Return (ip, prefix) of the first IPv4 on `name`, or None."""
    try:
        out = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", "dev", name],
            capture_output=True, text=True, timeout=5,
        ).stdout
        for line in out.splitlines():
            parts = line.split()
            for i, p in enumerate(parts):
                if p == "inet" and i + 1 < len(parts):
                    ip, prefix = parts[i + 1].split("/")
                    return ip, int(prefix)
    except Exception as e:
        log.debug("get_interface_ip(%s) failed: %s", name, e)
    return None


class SnxRsPlugin(dbus.service.Object):
    def __init__(self, bus, path, mainloop):
        super().__init__(bus, path)
        self.mainloop   = mainloop
        self.state      = S_INIT
        self.snx_proc   = None
        self.cfg_path   = None
        self.iface      = DEFAULT_IFACE
        self.server     = ""
        self.lock       = threading.Lock()
        self.supervisor = None
        self._stop_supervisor = threading.Event()
        # If snx-rs.service is left running it would fight us for the tunnel.
        # Stop (not disable; user can re-enable for CLI-only use) on first start.
        self._stop_system_service()

    # ───────────────────── NM D-Bus methods ─────────────────────

    @dbus.service.method(IFACE, in_signature="a{sa{sv}}")
    def Connect(self, connection):
        log.info("Connect()")
        threading.Thread(target=self._do_connect, args=(connection,), daemon=True).start()

    @dbus.service.method(IFACE, in_signature="a{sa{sv}}a{sv}")
    def ConnectInteractive(self, connection, details):
        log.info("ConnectInteractive()")
        threading.Thread(target=self._do_connect, args=(connection,), daemon=True).start()

    @dbus.service.method(IFACE, in_signature="a{sa{sv}}", out_signature="s")
    def NeedSecrets(self, connection):
        secrets = connection.get("vpn", {}).get("secrets", {})
        if "password" in secrets and str(secrets["password"]):
            return ""
        return "vpn"

    @dbus.service.method(IFACE)
    def Disconnect(self):
        log.info("Disconnect()")
        threading.Thread(target=self._do_disconnect, args=(True,), daemon=True).start()

    @dbus.service.method(IFACE, in_signature="a{sv}")
    def SetConfig(self, config): pass
    @dbus.service.method(IFACE, in_signature="a{sv}")
    def SetIp4Config(self, config): pass
    @dbus.service.method(IFACE, in_signature="a{sv}")
    def SetIp6Config(self, config): pass
    @dbus.service.method(IFACE, in_signature="s")
    def SetFailure(self, reason): log.warning("SetFailure: %s", reason)

    @dbus.service.method(IFACE, in_signature="a{sa{sv}}")
    def NewSecrets(self, connection):
        log.info("NewSecrets()")
        threading.Thread(target=self._do_connect, args=(connection,), daemon=True).start()

    # ───────────────────── NM D-Bus signals ─────────────────────

    @dbus.service.signal(IFACE, signature="u")
    def StateChanged(self, state): pass
    @dbus.service.signal(IFACE, signature="a{sv}")
    def Config(self, config): pass
    @dbus.service.signal(IFACE, signature="a{sv}")
    def Ip4Config(self, config): pass
    @dbus.service.signal(IFACE, signature="a{sv}")
    def Ip6Config(self, config): pass
    @dbus.service.signal(IFACE, signature="s")
    def LoginBanner(self, banner): pass
    @dbus.service.signal(IFACE, signature="u")
    def Failure(self, reason): pass
    @dbus.service.signal(IFACE, signature="sas")
    def SecretsRequired(self, message, hints): pass

    # ───────────────────── implementation ─────────────────────

    def _set_state(self, state):
        self.state = state
        GLib.idle_add(self.StateChanged, dbus.UInt32(state))

    def _emit_failure(self, reason):
        GLib.idle_add(self.Failure, dbus.UInt32(reason))

    def _stop_system_service(self):
        try:
            subprocess.run(["systemctl", "stop", "snx-rs.service"],
                           capture_output=True, timeout=10)
        except Exception:
            pass

    def _do_connect(self, connection):
        with self.lock:
            if self.state in (S_STARTING, S_STARTED):
                log.info("already starting/started — ignoring duplicate Connect")
                return

            vpn     = dict(connection.get("vpn", {}))
            data    = dict(vpn.get("data", {}))
            secrets = dict(vpn.get("secrets", {}))

            # NM stores user-name as a top-level vpn property (vpn.user-name),
            # not inside vpn.data — it's filtered out of vpn.data on save.
            # Fall back to data["user-name"] in case the caller stuffed it there.
            server     = str(data.get("server-name", "")).strip()
            self.server = server
            user       = (str(vpn.get("user-name", "")).strip()
                          or str(data.get("user-name", "")).strip())
            tunnel     = str(data.get("tunnel-type", "ipsec")).strip() or "ipsec"
            login_type = str(data.get("login-type", "vpn")).strip() or "vpn"
            ifname     = (str(data.get("if-name", "")).strip() or DEFAULT_IFACE)
            password   = str(secrets.get("password", "")).strip()

            self.iface = ifname

            if not server or not user:
                log.error("missing server-name or user-name in vpn.data")
                self._emit_failure(F_BAD_IP_CONFIG)
                self._set_state(S_STOPPED)
                self._schedule_quit()
                return

            if not password:
                log.info("no password in secrets — emitting SecretsRequired")
                GLib.idle_add(self.SecretsRequired, "VPN password", ["password"])
                return

            self._set_state(S_STARTING)
            self._stop_system_service()

            # Per-connection ephemeral config in /run (tmpfs, root-owned 600).
            fd, self.cfg_path = tempfile.mkstemp(prefix="nm-snx-rs-", suffix=".conf", dir="/run")
            os.close(fd)
            os.chmod(self.cfg_path, 0o600)
            with open(self.cfg_path, "w") as f:
                f.write(f"server-name = {server}\n")
                f.write(f"user-name = {user}\n")
                f.write(f"login-type = {login_type}\n")
                f.write(f"tunnel-type = {tunnel}\n")
                f.write(f"if-name = {ifname}\n")
                f.write("keychain = false\n")
                f.write("log-level = info\n")

            pw_b64 = base64.b64encode(password.encode("utf-8")).decode("ascii")
            argv = [SNX_RS, "-c", self.cfg_path, "-p", pw_b64, "-m", "standalone"]
            log.info("spawning snx-rs (config=%s)", self.cfg_path)
            try:
                self.snx_proc = subprocess.Popen(
                    argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                )
            except Exception as e:
                log.error("failed to spawn snx-rs: %s", e)
                self._emit_failure(F_CONNECT_FAILED)
                self._cleanup_files()
                self._set_state(S_STOPPED)
                self._schedule_quit()
                return

            threading.Thread(target=self._drain_output, daemon=True).start()

            for _ in range(WAIT_TIMEOUT):
                if self.snx_proc.poll() is not None:
                    log.error("snx-rs exited early rc=%s", self.snx_proc.returncode)
                    self._emit_failure(F_LOGIN_FAILED)
                    self._cleanup_files()
                    self._set_state(S_STOPPED)
                    self._schedule_quit()
                    return
                ip_info = get_interface_ip(self.iface)
                if ip_info:
                    log.info("interface %s up: %s/%d", self.iface, *ip_info)
                    self._send_config(*ip_info)
                    self._set_state(S_STARTED)
                    self._start_supervisor()
                    return
                time.sleep(1)

            log.error("timeout waiting for %s", self.iface)
            self._emit_failure(F_CONNECT_FAILED)
            self._do_disconnect(quit_after=True)

    def _start_supervisor(self):
        """Background watcher: if snx-rs dies or the tunnel interface
        disappears while we think we're STARTED, tell NM cleanly so it
        moves to disconnected state instead of waiting on a dead tunnel."""
        self._stop_supervisor.clear()
        self.supervisor = threading.Thread(target=self._supervise, daemon=True)
        self.supervisor.start()

    def _supervise(self):
        log.info("supervisor started")
        while not self._stop_supervisor.wait(5):
            if self.state != S_STARTED:
                break
            if self.snx_proc and self.snx_proc.poll() is not None:
                log.error("snx-rs subprocess died (rc=%s) — failing tunnel",
                          self.snx_proc.returncode)
                self._emit_failure(F_CONNECT_FAILED)
                self._do_disconnect(quit_after=True)
                return
            if get_interface_ip(self.iface) is None:
                log.error("interface %s disappeared — failing tunnel", self.iface)
                self._emit_failure(F_CONNECT_FAILED)
                self._do_disconnect(quit_after=True)
                return
        log.info("supervisor exiting")

    def _drain_output(self):
        if not self.snx_proc:
            return
        try:
            for line in self.snx_proc.stdout:
                log.info("snx-rs: %s", line.rstrip())
        except Exception:
            pass

    def _send_config(self, ip, prefix):
        # Resolve gateway IP so NM knows to route packets to the gateway via
        # the underlying interface (not into the tunnel).
        gw_int = 0
        try:
            gw_ip = socket.gethostbyname(self.server)
            gw_int = ip_to_uint32(gw_ip)
        except Exception as e:
            log.warning("could not resolve gateway %s: %s", self.server, e)

        # has-ip4=true is REQUIRED — without it NM doesn't wait for the
        # Ip4Config signal and just times out at 60 s.
        cfg = dbus.Dictionary({
            "tundev":   dbus.String(self.iface),
            "gateway":  dbus.UInt32(gw_int),
            "mtu":      dbus.UInt32(1350),
            "has-ip4":  dbus.Boolean(True),
            "has-ip6":  dbus.Boolean(False),
            "can-persist": dbus.Boolean(False),
        }, signature="sv")
        ip4 = dbus.Dictionary({
            "tundev":  dbus.String(self.iface),
            "address": dbus.UInt32(ip_to_uint32(ip)),
            "prefix":  dbus.UInt32(prefix),
            "mtu":     dbus.UInt32(1350),
        }, signature="sv")
        GLib.idle_add(self.Config, cfg)
        GLib.idle_add(self.Ip4Config, ip4)

    def _cleanup_files(self):
        if self.cfg_path and os.path.exists(self.cfg_path):
            try:
                os.unlink(self.cfg_path)
            except Exception:
                pass
        self.cfg_path = None

    def _do_disconnect(self, quit_after):
        if self.state == S_STOPPED:
            if quit_after:
                self._schedule_quit()
            return

        self._set_state(S_STOPPING)
        self._stop_supervisor.set()

        if self.snx_proc and self.snx_proc.poll() is None:
            log.info("terminating snx-rs (pid %d)", self.snx_proc.pid)
            try:
                self.snx_proc.terminate()
                try:
                    self.snx_proc.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    log.warning("snx-rs did not exit in 15s, killing")
                    self.snx_proc.kill()
                    self.snx_proc.wait(timeout=5)
            except Exception as e:
                log.warning("error terminating snx-rs: %s", e)
        self.snx_proc = None

        self._cleanup_files()
        self._set_state(S_STOPPED)

        if quit_after:
            self._schedule_quit()

    def _schedule_quit(self):
        GLib.timeout_add_seconds(2, self._quit)

    def _quit(self):
        log.info("exiting")
        self.mainloop.quit()
        return False


def _setup_logging():
    """Log to systemd journal with SYSLOG_IDENTIFIER=nm-snx-rs so
    `journalctl -t nm-snx-rs` finds us. Falls back to stderr if the
    systemd python bindings aren't installed."""
    root = logging.getLogger()
    root.setLevel(logging.INFO)
    try:
        from systemd.journal import JournalHandler
        h = JournalHandler(SYSLOG_IDENTIFIER="nm-snx-rs")
        h.setFormatter(logging.Formatter("%(message)s"))
    except ImportError:
        h = logging.StreamHandler(sys.stderr)
        h.setFormatter(logging.Formatter(
            "nm-snx-rs[%(process)d]: %(message)s"))
    root.addHandler(h)


def main():
    _setup_logging()
    log.info("starting (pid %d)", os.getpid())

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    bus_name = dbus.service.BusName(SERVICE_NAME, bus=bus)
    loop = GLib.MainLoop()
    plugin = SnxRsPlugin(bus, OBJECT_PATH, loop)

    def _sig(_signo, _frame):
        log.info("signal received, shutting down")
        plugin._do_disconnect(quit_after=True)
    signal.signal(signal.SIGTERM, _sig)
    signal.signal(signal.SIGINT, _sig)

    try:
        loop.run()
    finally:
        log.info("done")


if __name__ == "__main__":
    main()
